# mi vida — web-dashboard / backend env. Copy to .env and fill in. NEVER commit .env (it is gitignored).

# ── Database (Postgres, e.g. Aiven) ─────────────────────────────
DATABASE_URL="postgres://user:pass@host:port/db?sslmode=require"
# Preferred secure path for a self-signed CA (Aiven): paste the CA cert PEM here.
# If unset, the DB pool falls back to an encrypted-but-unverified TLS connection (scoped to the pool only).
DATABASE_CA_CERT=

# ── Auth ────────────────────────────────────────────────────────
# Mobile: the single shared key the device sends as `x-http-key` (verified constant-time). Use a long random value.
MOBILE_HTTP_KEY="change-me-long-random"
# Web session cookie signing secret (HMAC). Use a long random value.
SESSION_SECRET="change-me-long-random"
# First-run web admin. WEB_ADMIN_PASSWORD_HASH is a scrypt hash in the form  scrypt:<saltHex>:<hashHex>.
# Generate one with:  node -e "console.log(require('./scripts/hash-password.js')('yourpassword'))"  (see scripts/, slice 3.6)
WEB_ADMIN_EMAIL="you@example.com"
WEB_ADMIN_PASSWORD_HASH=""

# ── Cloudflare R2 (object storage; presigned uploads) ───────────
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
R2_BUCKET="mivida"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# ── Google Calendar OAuth (server-side tokens) ──────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/w/google/oauth/callback"
# Encrypts Google access/refresh tokens at rest.
TOKEN_ENC_KEY=""

# ── WakaTime ────────────────────────────────────────────────────
# Preferred: the WakaTime API key (Basic-auth base64 of the KEY, not a password).
WAKATIME_API_KEY=""
# Optional: only for the fragile public-profile scrape fallback.
WAKATIME_USERNAME=""
WAKATIME_PASSWORD=""

# ── Cron (server time-authority; protects internal cron routes) ─
CRON_SECRET="change-me-long-random"
