# mi vida — mobile app env. Copy to .env. EXPO_PUBLIC_* vars are embedded in the bundle at build time.

# Backend base URL (the web-dashboard). Examples:
#   http://10.0.2.2:3000   — Android emulator talking to host localhost
#   http://192.168.1.20:3000 — physical device on the same LAN
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Mobile auth key. Must equal the server's MOBILE_HTTP_KEY.
# NOTE: EXPO_PUBLIC_* is NOT secret (it ships in the bundle). Prefer storing the key in secure-store via
# SyncService.setHttpKey(); this env value is only a dev fallback.
EXPO_PUBLIC_HTTP_KEY=
