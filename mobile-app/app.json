{
  "expo": {
    "name": "Mi Vida",
    "slug": "mi-vida",
    "scheme": "mivida",
    "version": "1.0.0",
    "plugins": [
      "./plugins/withWatermelonDB",
      "./plugins/withNotifee",
      "expo-router",
      "expo-secure-store"
